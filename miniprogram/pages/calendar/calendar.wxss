.cal-card {
  padding: 24rpx 16rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 16rpx;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #14312a;
}

.cal-nav {
  font-size: 24rpx;
  color: #00573f;
  padding: 8rpx 16rpx;
}

.cal-row {
  display: flex;
}

.cal-cell {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 10rpx 0 8rpx;
  border-radius: 12rpx;
}

.cal-cell.head {
  font-size: 22rpx;
  color: #8a8f99;
  padding: 6rpx 0;
}

.cal-day {
  font-size: 26rpx;
  color: #1f2430;
}

.cal-cell.dim .cal-day {
  color: #c4c8ce;
}

.cal-cell.today .cal-day {
  color: #00573f;
  font-weight: 700;
}

.cal-cell.selected {
  background: #00573f;
}

.cal-cell.selected .cal-day {
  color: #ffffff;
  font-weight: 600;
}

.cal-dots {
  display: flex;
  justify-content: center;
  height: 12rpx;
  margin-top: 4rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin: 0 2rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 12rpx 0;
  border-top: 1rpx solid #eef0f2;
  margin-top: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #6b7280;
  margin: 0 20rpx 8rpx 0;
}

.legend-item .dot {
  margin-right: 8rpx;
}

/* 事件条 */
.sel-event,
.month-event {
  display: flex;
  align-items: flex-start;
}

.month-event {
  padding: 22rpx 28rpx;
  margin-top: 0;
}

.sel-event {
  padding: 10rpx 0;
}

.event-bar {
  width: 8rpx;
  height: 56rpx;
  border-radius: 4rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.sel-body {
  flex: 1;
}

.sel-title {
  font-size: 26rpx;
  color: #1f2430;
}

.sel-sub {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 2rpx;
}

.empty {
  color: #8a8f99;
  text-align: center;
  font-size: 24rpx;
}

.footer-note {
  text-align: center;
  padding: 24rpx 40rpx 48rpx;
}
